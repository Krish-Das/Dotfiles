{
  "vim.enableVim": true,
  "vim.useSystemClipboard": false,
  "search.smartCase": true,
  "breadcrumbs.filePath": "last",
  "breadcrumbs.enabled": false,

  "editor.fontSize": 15.5,
  "editor.renderLineHighlight": "all",
  "editor.fontFamily": "'JetBrains Mono', 'JetBrainsMono Nerd Font', 'SF Mono', 'Droid Sans Mono', 'monospace', monospace",
  "editor.lineHeight": 0,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,

  "window.title": "${dirty}${activeEditorMedium}${separator}${rootName}",
  "window.zoomLevel": 0,
  "window.menuBarVisibility": "compact",
  "window.density.editorTabHeight": "compact",
  "window.commandCenter": false,

  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "selection",
  "editor.guides.indentation": false,
  "editor.glyphMargin": false,
  "editor.scrollbar.vertical": "auto",
  "editor.scrollbar.horizontal": "auto",
  "editor.stickyScroll.enabled": false,
  "editor.colorDecorators": false,
  "editor.codeLens": false,
  "editor.matchBrackets": "near",
  "editor.parameterHints.enabled": true,
  "editor.lightbulb.enabled": "off",
  "editor.guides.highlightActiveIndentation": true,
  "editor.snippetSuggestions": "inline",
  "editor.formatOnSave": true,
  "editor.autoIndentOnPaste": true,
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.wordWrap": "off",
  "editor.autoClosingBrackets": "always",
  "editor.linkedEditing": true,
  "editor.lineNumbers": "relative",
  "editor.find.autoFindInSelection": "always",
  "editor.fontLigatures": false,
  "editor.tabCompletion": "off",
  "editor.quickSuggestions": {
    "comments": "off",
    "strings": "off",
    "other": "off"
  },
  "editor.defaultFormatter": "biomejs.biome",
  "editor.experimentalGpuAcceleration": "off",
  "editor.foldingImportsByDefault": false,

  "files.insertFinalNewline": false,

  "workbench.editor.tabActionLocation": "left",
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.enablePreview": true,
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.showIcons": false,
  "workbench.editor.editorActionsLocation": "hidden",
  "explorer.excludeGitIgnore": false,
  "explorer.openEditors.visible": 2,
  "workbench.sideBar.location": "left",

  "telemetry.editStats.enabled": false,
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",
  "update.mode": "none",

  "workbench.panel.defaultLocation": "right",
  "workbench.panel.opensMaximized": "always",
  "workbench.panel.showLabels": false,
  "workbench.activityBar.location": "bottom",
  "workbench.statusBar.visible": true,
  "workbench.tips.enabled": false,
  "workbench.tree.enableStickyScroll": false,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tree.indent": 18,
  "explorer.compactFolders": false,
  "extensions.ignoreRecommendations": true,
  "chat.commandCenter.enabled": false,
  "workbench.navigationControl.enabled": false,
  "workbench.layoutControl.enabled": false,

  "terminal.integrated.allowChords": true,
  "terminal.integrated.defaultLocation": "view",

  "errorLens.enabledDiagnosticLevels": ["warning", "info", "error"],
  "errorLens.enabled": false,

  "prettier.requireConfig": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": "always"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "[typst]": {
    "editor.defaultFormatter": "myriad-dreamin.tinymist"
  },
  "qt-qml.qmlls.useQmlImportPathEnvVar": true,
  "qmlFormatter.indentSize": 2,
  "[qml]": {
    "editor.defaultFormatter": "qml-formatter.noQt-qml-formatter"
  },
  "grammarly.files.include": [
    "**/readme.md",
    "**/README.md",
    "**/*.txt",
    "**/*.mdx"
  ],

  // ----------------------------------
  // ---------  vim mode  -------------
  // ----------------------------------
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },
  "vim.enableNeovim": true,
  "vim.neovimUseConfigFile": false,
  "vim.statusBarColorControl": false,
  "vim.showcmd": true,
  "vim.hlsearch": false,
  "vim.incsearch": true,
  "vim.easymotion": false,
  "vim.leader": "<space>",
  "vim.surround": true,
  "vim.neovimPath": "/run/current-system/sw/bin/nvim",
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "p", "p"],
      "commands": ["workbench.action.showCommands"]
    },
    {
      "before": ["<leader>", "f", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["<leader>", "<space>"],
      "commands": ["workbench.action.showAllEditorsByMostRecentlyUsed"]
    },
    {
      "before": ["<leader>", "f", "q"],
      "commands": ["workbench.actions.view.problems"]
    },
    {
      "before": ["<leader>", "f", "g"],
      "commands": ["workbench.action.quickTextSearch"]
    },
    {
      "before": ["<leader>", "u", "C"],
      "commands": ["workbench.action.selectTheme"]
    },
    {
      "before": ["<leader>", "f", "h"],
      "commands": ["workbench.action.openGlobalKeybindingsFile"]
    },
    {
      "before": ["<leader>", "f", "k"],
      "commands": ["workbench.action.openGlobalKeybindings"]
    },
    {
      "before": ["<leader>", "f", "s"],
      "commands": ["workbench.action.gotoSymbol"]
    },
    {
      "before": ["<leader>", "f", "S"],
      "commands": ["workbench.action.showAllSymbols"]
    },
    {
      "before": ["<leader>", "g", "g"],
      "commands": ["workbench.view.scm"]
    },
    {
      "before": ["<leader>", "f", "m"],
      "commands": ["editor.action.formatDocument"]
    },
    {
      "before": ["<leader>", "w"],
      "commands": ["workbench.action.files.saveWithoutFormatting"]
    },
    {
      "before": ["<leader>", "a"],
      "after": ["g", "g", "V", "G"]
    },
    {
      "before": ["<leader>", "b", "n"],
      "commands": ["workbench.action.nextEditor"]
    },
    {
      "before": ["<leader>", "b", "p"],
      "commands": ["workbench.action.previousEditor"]
    },
    { "before": ["<leader>", "e"], "commands": ["workbench.view.explorer"] },
    {
      "before": ["<leader>", "y", "y"],
      "commands": ["editor.action.clipboardCopyAction"]
    },

    // ]d ]e ]w bindings : editor.action.marker.nextError editor.action.marker.nextWarning
    {
      "before": ["]", "d"],
      "commands": ["editor.action.marker.next"],
      "when": "editorFocus"
    },
    {
      "before": ["[", "d"],
      "commands": ["editor.action.marker.prev"],
      "when": "editorFocus"
    },

    // Error lens
    {
      "before": ["<leader>", "t", "d"],
      "commands": ["errorLens.toggle"],
      "when": "editorFocus"
    },
    {
      "before": ["g", "r", "r"],
      "commands": ["references-view.findReferences"],
      "when": "editorTextFocus && editorHasReferenceProvider"
    },
    {
      "before": ["g", "."],
      "commands": ["editor.action.quickFix"],
      "when": "editorTextFocus && editorHasReferenceProvider"
    },
    {
      "before": ["g", ">"],
      "commands": ["leap.findForward"]
    },
    {
      "before": ["g", "<"],
      "commands": ["leap.findBackward"]
    },
    {
      "before": ["]", "c"],
      "commands": ["workbench.action.editor.nextChange"]
    },
    {
      "before": ["[", "c"],
      "commands": ["workbench.action.editor.previousChange"]
    },

    // Git hunk bindings
    {
      "before": ["<leader>", "h", "p"],
      "commands": ["git.openChange"]
    },
    {
      "before": ["<leader>", "h", "s"],
      "commands": ["git.stageSelectedRanges"]
    },
    {
      "before": ["<leader>", "h", "r"],
      "commands": ["git.revertSelectedRanges"]
    },
    {
      "before": ["<leader>", "h", "S"],
      "commands": ["git.stage"]
    },
    {
      "before": ["<leader>", "h", "R"],
      "commands": ["git.clean"]
    }
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "p", "p"],
      "commands": ["workbench.action.showCommands"]
    },
    {
      "before": ["<leader>", "y"],
      "commands": ["editor.action.clipboardCopyAction", "cancelSelection"]
    },

    // Git hunk bindings
    {
      "before": ["<leader>", "h", "s"],
      "commands": ["git.stageSelectedRanges"]
    },
    {
      "before": ["<leader>", "h", "r"],
      "commands": ["git.revertSelectedRanges"]
    }
  ],
  "vim.handleKeys": {
    "<C-s>": false
  },
  "workbench.editorAssociations": {
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
    "*.qrc": "qt-core.qrcEditor"
  },
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://biomejs.dev": true
  }
}

[
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space f f": "file_finder::Toggle",
      "space f m": "editor::Format",
      "space e": "project_panel::ToggleFocus",
      "shift-y": ["workspace::SendKeystrokes", "y $"]
    }
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "shift-x": "vim::Exchange"
    }
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "space a": "editor::SelectAll",
      "alt-k": "editor::MoveLineUp",
      "alt-j": "editor::MoveLineDown",
      "alt-s": "vim::PushSneak", // <leader>' → Sneak forward
      "shift-s": "vim::PushSneakBackward" // <leader>" → Sneak backward
    }
  },

  //
  // Completion menu in insert mode
  //
  {
    "context": "Editor && vim_mode == insert && showing_completions",
    "bindings": {
      // "ctrl-y": "editor::ConfirmCompletion",
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      ".": "project_panel::ToggleHideGitIgnore",
      "q": "workspace::ToggleRightDock",
      "space e": "workspace::ToggleRightDock",
      "h": null,
      "z": "project_panel::CollapseSelectedEntry"
    }
  }
]

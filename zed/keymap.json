// vim:fileencoding=utf-8:ft=jsonc
[
  /*
   * Disable default bindings where custom chords live elsewhere (see Vim / leader).
   */
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-b": null, // → space e (project panel)
      "ctrl-shift-f": null, // → space f g (search)
      "ctrl-shift-p": null, // → : command palette
      "ctrl-shift-tab": null,
      "ctrl-tab": null, // → space space (tab switcher)
    },
  },
  {
    "context": "Pane || Workspace || Terminal",
    "bindings": {
      "ctrl-w": null, // → :q
    },
  },

  /*
   * Editor-wide: markdown preview toggle, paste, docks.
   */
  {
    "context": "Editor",
    "bindings": {
      "ctrl-k v": null, // disable side preview; use space p s in normal mode
      "ctrl-shift-v": "editor::Paste",
    },
  },

  /*
   * Vim — normal mode, leader / file / buffer / preview / yank helpers
   * (VimControl && vim_mode == normal)
   */
  {
    "context": "VimControl && vim_mode == normal",
    "bindings": {
      "g y": ["workspace::SendKeystrokes", "\" + y"], // start yanking to "+
      "space b n": "pane::ActivateNextItem",
      "space b p": "pane::ActivatePreviousItem",
      "space e": "project_panel::ToggleFocus",
      "space f f": "file_finder::Toggle",
      "space f g": "pane::DeploySearch",
      "space f m": "editor::Format",
      "space f s": "outline::Toggle",
      "space f shift-s": "project_symbols::Toggle",
      "space p p": "markdown::OpenPreview",
      "space p s": "markdown::OpenPreviewToTheSide",
      "space space": "tab_switcher::ToggleAll",
      "space o": "outline::Toggle",
    },
  },

  /*
   * Vim — visual mode
   */
  {
    "context": "vim_mode == visual",
    "bindings": {
      "g y": ["workspace::SendKeystrokes", "\" + y"],
      "shift-s": "vim::PushAddSurrounds",
      "shift-x": "vim::Exchange",
    },
  },

  /*
   * Vim — normal or visual (motion / sneak / lines / select all)
   */
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
      "alt-s": "vim::PushSneakBackward",
      "s": "vim::PushSneak",
      "space a": "editor::SelectAll",
    },
  },

  /*
   * Project panel (file tree), not editing a filename
   */
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      ".": "project_panel::ToggleHideGitIgnore",
      "h": null,
      "q": "project_panel::Toggle",
      "z": "project_panel::CollapseSelectedEntry",
    },
  },

  /*
   * Dock / split focus — ctrl-w + hjkl
   */
  {
    "context": "Dock",
    "bindings": {
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w j": "workspace::ActivatePaneDown",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w l": "workspace::ActivatePaneRight",
    },
  },
]

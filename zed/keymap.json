// vim:fileencoding=utf-8:ft=jsonc
[
  /*
   * GLOBAL DISABLES — avoid conflicts with Vim / leader system
   */
  {
    "context": "Pane || Workspace || Terminal",
    "bindings": {
      "ctrl-w": null,
    },
  },

  /*
   * EDITOR — generic editor behavior overrides
   */
  {
    "context": "Editor",
    "bindings": {
      "ctrl-k v": null, // disable side preview; use space p s in normal mode
      "ctrl-alt-t": null,
      "ctrl-shift-v": "editor::Paste",
    },
  },

  /*
   * VIM — core overrides / which-key prep
   */
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      "space": null, // Disable the default action vim::WrappingRight
    },
  },

  /*
   * VIM — NORMAL MODE (leader grouped)
   * Navigation / buffers / search / files / preview / diagnostics
   */
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      // diagnostics / toggle
      "space t d": "editor::ToggleInlineDiagnostics",

      // buffers
      "space b n": "pane::ActivateNextItem",
      "space b p": "pane::ActivatePreviousItem",

      // explorer / UI
      "space e": "workspace::ToggleLeftDock",
      "space o": "outline::Toggle",

      // files / search / symbols
      "space f f": "file_finder::Toggle",
      "space f g": "pane::DeploySearch",
      "space f m": "editor::Format",
      "space f s": "outline::Toggle",
      "space f shift-s": "project_symbols::Toggle",
      "space f q": "diagnostics::Deploy",

      // preview
      "space p p": "markdown::OpenPreview",
      "space p s": "markdown::OpenPreviewToTheSide",

      // tabs
      "space space": "tab_switcher::ToggleAll",

      // yank helpers
      "g y": ["workspace::SendKeystrokes", "\" + y"],
    },
  },

  /*
   * VIM — VISUAL MODE
   */
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "g y": ["workspace::SendKeystrokes", "\" + y"],
      "shift-s": "vim::PushAddSurrounds",
      "shift-x": "vim::Exchange",
    },
  },

  /*
   * VIM — SHARED (normal + visual)
   */
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
      "alt-s": "vim::PushSneakBackward",
      "s": "vim::PushSneak",
      "space a": "editor::SelectAll",
    },
  },

  /*
   * WINDOW / PANE NAVIGATION
   */
  {
    "context": "Dock",
    "bindings": {
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w j": "workspace::ActivatePaneDown",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w l": "workspace::ActivatePaneRight",
    },
  },

  /*
   * PROJECT PANEL — file explorer + netrw-style bindings
   */
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      // toggles
      ".": "project_panel::ToggleHideGitIgnore",
      "space e": "workspace::ToggleLeftDock",

      // command / creation
      ":": "command_palette::Toggle",
      "%": "project_panel::NewFile",
      "d": "project_panel::NewDirectory",
      "/": "project_panel::NewSearchInDirectory",

      // open
      "enter": "project_panel::OpenPermanent",
      "o": "project_panel::OpenPermanent",
      "t": "project_panel::OpenPermanent",
      "v": "project_panel::OpenPermanent",
      "p": "project_panel::Open",

      // navigation
      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious",
      "h": "project_panel::CollapseSelectedEntry",
      "l": "project_panel::ExpandSelectedEntry",
      "g g": "menu::SelectFirst",
      "shift-g": "menu::SelectLast",
      "-": "project_panel::SelectParent",

      // git / diagnostics
      "] c": "project_panel::SelectNextGitEntry",
      "[ c": "project_panel::SelectPrevGitEntry",
      "] d": "project_panel::SelectNextDiagnostic",
      "[ d": "project_panel::SelectPrevDiagnostic",

      // directory traversal
      "": "project_panel::SelectNextDirectory",
      "{": "project_panel::SelectPrevDirectory",

      // actions
      "shift-d": "project_panel::Delete",
      "shift-r": "project_panel::Rename",
      "x": "project_panel::RevealInFileManager",
      "s": "workspace::OpenWithSystem",

      // misc
      "escape": "project_panel::ToggleFocus",
      "ctrl-6": "pane::AlternateFile",
    },
  },
  {
    "unbind": {
      "ctrl-alt-i": "dev::ToggleInspector",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-alt-b": "workspace::ToggleRightDock",
      "ctrl-shift-f": "pane::DeploySearch",
      "ctrl-shift-p": "command_palette::Toggle",
      "ctrl-w": "workspace::CloseActiveDock",
      "ctrl-tab": "tab_switcher::Toggle",
      "ctrl-shift-tab": [
        "tab_switcher::Toggle",
        {
          "select_last": true,
        },
      ],
    },
    "bindings": {
      "ctrl-alt-i": "agent::Toggle",
    },
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-shift-f": "project_search::ToggleFocus",
    },
  },
  {
    "context": "RulesLibrary",
    "unbind": {
      "ctrl-w": "workspace::CloseWindow",
    },
  },
  {
    "context": "SettingsWindow",
    "unbind": {
      "ctrl-w": "workspace::CloseWindow",
    },
  },
]

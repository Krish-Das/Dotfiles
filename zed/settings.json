{
  "agent": {
    "play_sound_when_agent_done": true,
    "use_modifier_to_send": true,
    "default_model": {
      "provider": "openai",
      "model": "gpt-4o"
    },
    "always_allow_tool_actions": false
  },
  "auto_update": false,
  "base_keymap": null,
  "command_aliases": {
    "W": "w",
    "Wa": "wa",
    "Wq": "wq",
    "Wqa": "wqa",
    "Q": "q",
    "Bd": "bd",
    "Bn": "bn",
    "Bp": "bp",
    "Bda": "bda",
    "l": "ls"
  },

  //
  // Vim mode
  //
  "diagnostics.ignored_files": ["**/bun.lock"],
  "drag_and_drop_selection": {
    "enabled": false
  },
  "ensure_final_newline_on_save": false,
  "gutter": {
    "folds": false,
    "runnables": false,
    "breakpoints": false,
    "line_numbers": true
  },
  "hide_mouse": "on_typing",
  "indent_guides": {
    "enabled": false
  },
  "inlay_hints": {
    "enabled": false
  },
  "inline_code_actions": false,
  "languages": {
    "Nix": {
      "formatter": {
        "external": {
          "command": "alejandra",
          "arguments": ["--quiet", "--"]
        }
      }
    }
  },
  "linked_edits": false,
  "max_tabs": 5,
  "middle_click_paste": false,

  "preview_tabs": {
    "enabled": true
  },
  "projects_online_by_default": false,
  "project_panel": {
    "hide_gitignore": false,
    "default_width": 320,
    "dock": "right",
    "entry_spacing": "standard"
  },
  "relative_line_numbers": true,
  "scrollbar": {
    "show": "never"
  },
  "show_completions_on_input": true,
  "show_whitespaces": null,
  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": false
  },
  "title_bar": {
    "show_project_items": false,
    "show_menus": false,
    "show_sign_in": false
  },
  "tab_bar": {
    "show": false,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": false
  },
  "theme": {
    "mode": "system",
    "light": "Rosé Pine",
    "dark": "Rosé Pine"
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
  },
  "ui_font_family": "SF Pro Rounded",
  "ui_font_size": 14,
  "unnecessary_code_fade": 0.75,
  "use_autoclose": false,
  "use_modifier_to_send": true,
  "use_multiline_find": true,
  "use_smartcase_search": true,
  "vertical_scroll_margin": 0,
  "vim": {
    "use_system_clipboard": "never"
  },
  "vim_mode": true

  // Reat the disscussion:
  // https://github.com/zed-industries/zed/issues/5040
  // "experimental.theme_overrides": {
  //   // Get the Hex values from here:
  //   // https://gist.github.com/lopspower/03fb1cc0ac9f32ef38f4
  //   // fromat: #FFFFFF_66 (40% alpha)
  //   "background.appearance": "blurred",
  //   "background": "#00000082",
  //   "title_bar.background": "#000000D9",
  //   "toolbar.background": "#000000D9",
  //   "tab_bar.background": "#000000D9",
  //   "tab.inactive_background": "#000000D9",
  //   "tab.active_background": "#000000D9",
  //   "panel.background": "#000000D9",
  //   "editor.background": "#000000D9",
  //   "status_bar.background": "#000000D9",
  //   "editor.gutter.background": "#0kjk00000D9"
  //   "editor.active_line.background": "#FFF1",
  // }
}

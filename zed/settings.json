{
  // ── WINDOW & SESSION ─────────────────────────────────────────
  "cursor_shape": null,
  "diff_view_style": "unified",
  "when_closing_with_no_tabs": "keep_window_open",
  "session": {
    "trust_all_worktrees": false,
  },

  // ── THEME & TYPOGRAPHY ───────────────────────────────────────
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 14,
  "buffer_font_features": {
    "calt": false,
    "ss01": true,
    "zero": true,
  },
  "ui_font_family": "SF Pro Text",
  "ui_font_size": 12.0,
  "agent_buffer_font_size": 12.0,
  "agent_ui_font_size": 12.0,

  // ── PRIVACY, UPDATES, TELEMETRY ──────────────────────────────
  "redact_private_values": true,
  "auto_update": false,
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },

  // ── SEARCH & NAVIGATION ──────────────────────────────────────
  "search": {
    "button": false,
    "regex": true,
  },
  "use_smartcase_search": true,
  "sticky_scroll": {
    "enabled": false,
  },
  "preview_tabs": {
    "enabled": true,
  },

  // ── FILES & SAVE BEHAVIOR ────────────────────────────────────
  "file_scan_exclusions": [
    "**/bun.lock",
    "**/out",
    "**/dist",
    "**/.husky",
    "**/.turbo",
    "**/.vscode-test",
    "**/.vscode",
    "**/.next",
    "**/.storybook",
    "**/.tap",
    "**/.nyc_output",
    "**/report",
    "**/node_modules",
  ],
  "ensure_final_newline_on_save": false,
  "remove_trailing_whitespace_on_save": true,

  // ── TABS ─────────────────────────────────────────────────────
  "max_tabs": 9,
  "tabs": {
    "show_close_button": "hidden",
    "show_diagnostics": "errors",
    "close_position": "left",
    "file_icons": false,
    "git_status": false,
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },

  // ── EDITOR: CORE TEXT & LAYOUT ───────────────────────────────
  "tab_size": 2,
  "buffer_line_height": "standard",
  "text_rendering_mode": "platform_default",
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 1.0,
  "hide_mouse": "on_typing",

  // ── EDITOR: GUTTER, GUIDES, VISUALS ──────────────────────────
  "gutter": {
    "bookmarks": false,
    "min_line_number_digits": 2,
    "folds": false,
    "runnables": false,
    "breakpoints": false,
    "line_numbers": true,
  },
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "fixed",
    "active_line_width": 1,
    "line_width": 1,
    "enabled": false,
  },
  "scrollbar": {
    "show": "never",
  },
  "show_whitespaces": "selection",
  "unnecessary_code_fade": 0.75,

  // ── EDITOR: HINTS & ASSIST ───────────────────────────────────
  "inlay_hints": {
    "enabled": false,
  },

  // ── EDITOR: TYPING, COMPLETIONS, EDITS ───────────────────────
  "show_completions_on_input": false,
  "inline_code_actions": false,
  "linked_edits": true,
  "use_on_type_format": false,
  "use_autoclose": false,
  "auto_indent_on_paste": false,

  // ── EDITOR: INPUT & SELECTION ────────────────────────────────
  "drag_and_drop_selection": {
    "enabled": false,
  },
  "middle_click_paste": false,

  // ── GIT ─────────────────────────────────────────────────────
  "git": {
    "hunk_style": "staged_hollow",
    "inline_blame": {
      "enabled": true,
      "show_commit_summary": true,
    },
  },

  // ── PANELS & DOCKS ───────────────────────────────────────────
  "project_panel": {
    "sort_mode": "directories_first",
    "hide_root": false,
    "indent_guides": {
      "show": "always",
    },
    "git_status_indicator": true,
    "diagnostic_badges": true,
    "scrollbar": {
      "show": "auto",
    },
    "bold_folder_labels": true,
    "indent_size": 20.0,
    "folder_icons": true,
    "file_icons": true,
    "button": true,
    "hide_hidden": true,
    "hide_gitignore": false,
    "default_width": 300,
    "dock": "left",
    "entry_spacing": "standard",
  },
  "terminal": {
    "button": false,
    "dock": "right",
    "font_size": 12,
  },
  "outline_panel": {
    "button": false,
    "file_icons": true,
    "dock": "left",
  },
  "git_panel": {
    "button": false,
    "show_count_badge": false,
    "diff_stats": true,
    "folder_icons": true,
    "file_icons": false,
    "tree_view": true,
    "fallback_branch_name": "main",
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "debugger": {
    "button": false,
  },
  "active_pane_modifiers": {
    "inactive_opacity": 0.8,
  },

  // ── UI CHROME ────────────────────────────────────────────────
  "title_bar": {
    "show_branch_name": true,
    "show_project_items": true,
    "show_menus": false,
    "show_sign_in": false,
  },
  "status_bar": {
    "show_active_file": true,
    "active_language_button": true,
    "cursor_position_button": true,
  },
  "toolbar": {
    "agent_review": true,
    "selections_menu": false,
    "breadcrumbs": false,
    "quick_actions": false,
  },

  // ── AGENT (AI) ──────────────────────────────────────────────
  "disable_ai": false,
  "show_edit_predictions": true,
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "zed",
    "mode": "eager",
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
  },
  "agent": {
    "button": false,
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "default_profile": "ask",
    "play_sound_when_agent_done": "always",
    "use_modifier_to_send": true,
    "default_model": {
      "provider": "openrouter",
      "model": "qwen/qwen3-coder-30b-a3b-instruct",
    },
    "commit_message_model": {
      "provider": "openai",
      "model": "gpt-4o-mini",
    },
  },

  // ── MCP / CONTEXT SERVERS ───────────────────────────────────
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "settings": {
        "context7_api_key": "...",
      },
    },
  },

  // ── KEYMAP & HINTS ──────────────────────────────────────────
  "which_key": {
    "enabled": true,
  },
  "base_keymap": "VSCode",

  // ── VIM ─────────────────────────────────────────────────────
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": false,
    "use_system_clipboard": "never",
    "use_smartcase_find": true,
  },
  "command_aliases": {
    "W": "w",
    "Wa": "wa",
    "Wq": "wq",
    "Wqa": "wqa",
    "Q": "q",
    "Bd": "bd",
    "Bn": "bn",
    "Bp": "bp",
    "Bda": "bda",
    "l": "ls",
  },

  // ── PER-LANGUAGE TOOLING ─────────────────────────────────────
  "languages": {
    "JavaScript": {
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "TypeScript": {
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "TSX": {
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "CSS": {
      "language_servers": ["!vscode-css-language-server", "..."],
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "Nix": {
      "formatter": {
        "external": {
          "command": "alejandra",
          "arguments": ["--quiet", "--"],
        },
      },
    },
  },

  // "lsp": {
  //   "biome": {
  //     "binary": {
  //       "path": "/run/current-system/sw/bin/biome",
  //       "arguments": ["lsp-proxy"],
  //     },
  //     "settings": {

// Workspace definitions, routing, and workspace-specific binds.

workspace "browser"
workspace "scratch"

window-rule {
    match app-id=r#"^(zen|zen-browser)$"#
    open-on-workspace "browser"
}

window-rule {
    match app-id="google-chrome"
    open-on-workspace "scratch"
}

binds {
    // Fixed workspaces.
    Mod+B { focus-workspace "browser"; }
    Mod+S { focus-workspace "scratch"; }

    // Project workspaces are positional and offset by the two fixed workspaces above.
    Mod+1 { focus-workspace 3; }
    Mod+2 { focus-workspace 4; }
    Mod+3 { focus-workspace 5; }
    Mod+4 { focus-workspace 6; }
    Mod+5 { focus-workspace 7; }
    Mod+6 { focus-workspace 8; }
    Mod+7 { focus-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 3; }
    Mod+Ctrl+2 { move-column-to-workspace 4; }
    Mod+Ctrl+3 { move-column-to-workspace 5; }
    Mod+Ctrl+4 { move-column-to-workspace 6; }
    Mod+Ctrl+5 { move-column-to-workspace 7; }
    Mod+Ctrl+6 { move-column-to-workspace 8; }
    Mod+Ctrl+7 { move-column-to-workspace 9; }
}
